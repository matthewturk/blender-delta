# Settings for render_frames.sh, render.sbatch and submit.sh. Paths are on the cluster.
BLEND="scene.blend"                            # in scene/; make_bundle fills this in
DATA_KEY="data.scene"                          # the config key DATA replaces; make_bundle fills this in
DATA="/work/hdd/bcdj/$USER/dataset.zip"        # the dataset, copied separately
OUT="/work/hdd/bcdj/$USER/renders/frames"      # output directory
FIRST=1                                        # frame range, inclusive
LAST=2500
CHUNK=250                                      # frames per Slurm array task
